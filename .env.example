# Alpaca market data credentials.
ALPACA_API_KEY="your_alpaca_api_key"
ALPACA_SECRET_KEY="your_alpaca_secret_key"

# Kraken spot trading API credentials.
KRAKEN_SPOT_API_KEY="your_kraken_spot_api_key"
KRAKEN_SPOT_API_SECRET="your_kraken_spot_api_secret"
KRAKEN_SYMBOL="BTC/USD"
KRAKEN_ORDER_SIZE="0.001"
KRAKEN_MAX_ORDER_SIZE="0.001"
KRAKEN_MAX_POSITION="0.001"
KRAKEN_DRY_RUN="true"
